                {
                  "id": "6becc72b-7a00-45e9-bf50-249ca4794a3c",
                  "title": "T16 - Penyalahgunaan akun Admin Akademik",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of Privilege",
                  "description": "Jika akun admin akademik diambil alih atau dipakai berlebihan, maka penyerang dapat melihat rekap seluruh kelas dan mengubah data jika hak akses terlalu luas. Dampak: Kebocoran data seluruh kelas; potensi manipulasi rekap. Asumsi: akun admin tanpa MFA dan memiliki hak tulis di luar kebutuhan rekap. Skor risiko: 1 x 3 = 3 (Sedang).",
                  "mitigation": "MFA untuk admin; hak akses minimum (rekap bersifat baca saja sesuai aturan); batas waktu sesi; audit akses rekap; tinjauan berkala hak akses.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 16,
                  "score": "3"
                }
              ],
              "providesAuthentication": false
            }
