            "data": {
              "type": "tm.Store",
              "name": "Database Akademik",
              "description": "",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isTrustBoundary": false,
              "threats": [
                {
                  "id": "2848607c-ca96-45b2-a31b-3db767916542",
                  "title": "T05 - Duplikasi catatan hadir lewat permintaan paralel (race condition)",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Tampering",
                  "description": "Jika mahasiswa mengirim banyak permintaan presensi bersamaan untuk sesi yang sama, maka cek-lalu-tulis yang tidak atomik dapat menghasilkan lebih dari satu catatan hadir. Dampak: Melanggar aturan bisnis satu catatan per sesi; rekap menggelembung. Asumsi: tidak ada constraint unik pada pasangan (sesi, mahasiswa) di database. Skor risiko: 2 x 2 = 4 (Sedang).",
                  "mitigation": "Unique constraint (id_sesi, id_mahasiswa); gunakan transaksi atau upsert; tanggapi permintaan ulang dengan hasil yang sama (idempoten).",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": "4"
                },
                {
