              "threats": [
                {
                  "id": "bafd7a87-e779-4b31-a2f1-4d3fe903005e",
                  "title": "T03 - Replay token QR atau token autentikasi yang disadap",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "description": "Jika pihak lain dapat menyalin permintaan presensi yang valid (id sesi, token QR, token autentikasi) dan mengirim ulang, maka ia dapat menghasilkan presensi atas akun korban atau setelah sesi ditutup. Dampak: Catatan hadir palsu atau ganda; integritas rekap terganggu. Asumsi: token autentikasi berumur panjang dan tidak terikat pada sesi presensi tertentu. Skor risiko: 2 x 2 = 4 (Sedang).",
                  "mitigation": "Token autentikasi berumur pendek dengan audience yang tepat; token QR terikat id sesi dan kedaluwarsa di sisi server; tolak permintaan bila sesi sudah ditutup; nonce sekali pakai; operasi presensi idempoten.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": "4"
                },
                {
                  "id": "98f00934-6380-426c-a130-a05f1ba434ea",
                  "title": "T09 - Kebocoran token atau data identitas pada transit dan log",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information Disclosure",
                  "description": "Jika koneksi tidak sepenuhnya dienkripsi, atau token tertulis di URL/log aplikasi, maka pihak lain dapat memperoleh token autentikasi atau token QR. Dampak: Pengambilalihan sesi; presensi palsu; paparan identitas. Asumsi: akses browser memakai HTTPS, tetapi konfigurasi dan praktik logging belum dijelaskan. Skor risiko: 2 x 3 = 6 (Tinggi).",
                  "mitigation": "TLS 1.2+ dengan HSTS; token dikirim lewat header/cookie HttpOnly, Secure, SameSite; jangan menaruh token di URL; masking token pada log; token berumur pendek.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 9,
                  "score": "6"
                }
              ]
            }
