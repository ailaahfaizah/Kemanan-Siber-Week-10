                },
                {
                  "id": "98f00934-6380-426c-a130-a05f1ba434ea",
                  "title": "T09 - Token atau data identitas bocor saat dikirim atau tersimpan di log",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information Disclosure",
                  "description": "Token login, token QR, atau data identitas dapat diketahui pihak lain jika pengiriman data tidak terlindungi dengan baik atau informasi sensitif ikut tersimpan di alamat URL maupun catatan aplikasi. Jika token tersebut disalahgunakan, orang lain bisa mencoba mengakses sesi atau melakukan presensi atas nama pengguna. Asumsi: meskipun koneksi menggunakan HTTPS, pengaturan keamanan dan penyimpanan log belum diketahui.",
                  "mitigation": "TLS 1.2+ dengan HSTS; token dikirim lewat header/cookie HttpOnly, Secure, SameSite; jangan menaruh token di URL; masking token pada log; token berumur pendek.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 9,
                  "score": "6"
                }
