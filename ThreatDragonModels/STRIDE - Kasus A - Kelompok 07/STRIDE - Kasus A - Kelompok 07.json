              "threats": [
                {
                  "id": "6becc72b-7a00-45e9-bf50-249ca4794a3c",
                  "title": "T16 - Akun Admin Akademik disalahgunakan",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of Privilege",
                  "description": "Jika akun Admin Akademik jatuh ke tangan orang lain atau digunakan melebihi kewenangannya, orang tersebut bisa melihat rekap banyak kelas dan mungkin mengubah data yang seharusnya tidak boleh diubah. Akibatnya, data kehadiran mahasiswa dapat bocor atau dimanipulasi. Asumsi: akun admin belum dilindungi verifikasi tambahan atau memiliki hak akses yang terlalu luas.",
                  "mitigation": "MFA untuk admin; hak akses minimum (rekap bersifat baca saja sesuai aturan); batas waktu sesi; audit akses rekap; tinjauan berkala hak akses.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 16,
                  "score": "3"
                }
              ],
