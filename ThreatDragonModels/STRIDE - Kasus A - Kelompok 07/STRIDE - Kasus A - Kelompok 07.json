              "isTrustBoundary": false,
              "threats": [
                {
                  "id": "75e91fe8-b08e-4711-bb45-361b25b7fa78",
                  "title": "T18 - XSS pada tampilan daftar hadir atau rekap di browser dosen/admin",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Jika nama atau data lain dari pengguna ditampilkan tanpa output encoding pada halaman rekap, maka skrip berbahaya dapat berjalan di browser dosen atau admin dan menjalankan aksi atas nama mereka. Dampak: Pengambilalihan sesi dosen/admin; perubahan sesi atau pencurian data rekap. Asumsi: data profil berasal dari sistem kampus tetapi tidak disanitasi saat ditampilkan. Skor risiko: 2 x 3 = 6 (Tinggi).",
                  "mitigation": "Output encoding kontekstual; Content-Security-Policy; cookie HttpOnly dan SameSite; token anti-CSRF pada aksi sesi; sanitasi input dan pembaruan library.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 18,
                  "score": "6"
                }
              ],
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
