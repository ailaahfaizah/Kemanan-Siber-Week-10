            "data": {
              "type": "tm.Store",
              "name": "Database Akademik",
              "description": "",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isTrustBoundary": false,
              "threats": [
                {
                  "id": "2848607c-ca96-45b2-a31b-3db767916542",
                  "title": "T05 - Membuat catatan hadir ganda dengan mengirim permintaan bersamaan",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Tampering",
                  "description": "Jika satu mahasiswa mengirim beberapa permintaan presensi secara bersamaan, sistem mungkin menyimpan lebih dari satu catatan untuk sesi yang sama. Akibatnya, jumlah catatan hadir menjadi tidak sesuai. Asumsi: database belum memastikan bahwa satu mahasiswa hanya memiliki satu catatan presensi untuk setiap sesi.",
                  "mitigation": "Unique constraint (id_sesi, id_mahasiswa); gunakan transaksi atau upsert; tanggapi permintaan ulang dengan hasil yang sama (idempoten).",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": "4"
                },
                {
                  "id": "dfe506c0-3500-4b09-8b9e-cc9317d5e6bd",
                  "title": "T06 - Mengubah atau menghapus data kehadiran tanpa izin",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Pihak yang tidak berwenang dapat mencoba mengubah atau menghapus catatan kehadiran, misalnya dengan memanfaatkan celah pada aplikasi atau akses database yang terlalu luas. Akibatnya, data presensi tidak lagi dapat dipercaya dan dapat menimbulkan masalah saat rekap kehadiran diperiksa. Asumsi: akun yang digunakan aplikasi memiliki hak akses lebih besar dari yang dibutuhkan.",
                  "mitigation": "Query berparameter/ORM; akun database dengan hak minimum (mis. tanpa DELETE/DDL); pemisahan akun baca dan tulis; audit perubahan data; backup dan verifikasi berkala; pemantauan akses database.",
                  "modelType": "STRIDE",
