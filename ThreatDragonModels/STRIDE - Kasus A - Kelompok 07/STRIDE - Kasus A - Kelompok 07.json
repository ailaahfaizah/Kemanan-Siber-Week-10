              "threats": [
                {
                  "id": "75e91fe8-b08e-4711-bb45-361b25b7fa78",
                  "title": "T18 - Skrip berbahaya berjalan saat dosen atau admin membuka rekap",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Jika data yang ditampilkan pada daftar hadir atau halaman rekap tidak ditangani dengan aman, seseorang bisa menyisipkan skrip berbahaya ke dalam data tersebut. Skrip itu dapat berjalan saat dosen atau admin membuka halaman, lalu berpotensi menyalahgunakan sesi mereka atau mengambil informasi yang sedang ditampilkan. Asumsi: data pengguna ditampilkan tanpa pemeriksaan atau pengamanan yang memadai.",
                  "mitigation": "Output encoding kontekstual; Content-Security-Policy; cookie HttpOnly dan SameSite; token anti-CSRF pada aksi sesi; sanitasi input dan pembaruan library.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 18,
                  "score": "6"
                }
              ],
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
