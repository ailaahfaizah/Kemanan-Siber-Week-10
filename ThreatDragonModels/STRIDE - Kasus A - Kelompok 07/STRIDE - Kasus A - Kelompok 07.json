            "id": "e9a522e9-829f-468e-9e75-4949bd99acac",
            "zIndex": 5,
            "data": {
              "type": "tm.Process",
              "name": "Backend Presensi",
              "description": "",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isTrustBoundary": false,
              "threats": [
                {
                  "id": "4d7d3fe8-8c02-4863-a7c5-2ff72c2954d1",
                  "title": "T04 - Mengubah data pada permintaan presensi",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Mahasiswa dapat mencoba mengubah data yang dikirim saat presensi, seperti ID mahasiswa, ID kelas, ID sesi, atau waktu. Jika sistem menerima perubahan tersebut tanpa pemeriksaan, kehadiran bisa tercatat untuk orang atau kelas yang salah. Asumsinya adalah sebagian data identitas atau waktu masih diterima langsung dari perangkat pengguna.",
                  "mitigation": "Turunkan identitas mahasiswa hanya dari token yang telah diverifikasi, bukan dari body, validasi server-side semua parameter terhadap keanggotaan kelas, gunakan waktu server, tolak parameter tidak dikenal, pengujian input negatif.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": "6"
                },
                {
                  "id": "feae7bb7-20e1-45b0-a134-78da44532d91",
                  "title": "T07 - Menyangkal tindakan karena tidak ada bukti yang jelas",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "Dosen dapat menyangkal pernah membuka atau menutup sesi, begitu juga mahasiswa yang menyangkal pernah melakukan presensi. Jika sistem tidak menyimpan catatan aktivitas dengan baik, pihak kampus akan kesulitan memastikan apa yang sebenarnya terjadi. Asumsinya catatan aktivitas yang tersedia masih terbatas dan dapat diubah oleh pihak tertentu.",
                  "mitigation": "Audit log untuk buka/tutup sesi, presensi, dan akses rekap (id pengguna, aksi, id sesi, waktu server, IP, user-agent), penyimpanan append-only atau tamper-evident, sinkronisasi waktu (NTP), bukti presensi bagi mahasiswa, retensi sesuai kebijakan kampus.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": "4"
                },
                {
                  "id": "49deeb7a-99d4-424e-bc3c-54d5dd4fd480",
                  "title": "T08 - Melihat daftar hadir atau rekap kelas lain",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information Disclosure",
                  "description": "Pengguna dapat mencoba mengganti ID kelas atau sesi saat membuka rekap. Jika sistem tidak memeriksa apakah pengguna memang berhak melihat data tersebut, daftar hadir kelas lain bisa ikut terbuka. Akibatnya, informasi mahasiswa seperti nama, NIM, dan kehadiran dapat diketahui oleh pihak yang tidak berkepentingan. Asumsinya adalah pemeriksaan hak akses belum dilakukan untuk setiap data kelas yang diminta.",
                  "mitigation": "Otorisasi per objek di setiap request (dosen harus pengampu kelas tersebut, mahasiswa hanya data sendiri), id acak (UUID), respons minimal, dan pengujian otorisasi horizontal.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 8,
                  "score": "6"
                },
                {
                  "id": "6a6cba55-c4b2-4652-af0e-bacd20a3e580",
                  "title": "T10 - QR dapat ditebak atau dibuat tanpa melihat QR di kelas",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "description": "Jika QR dibuat menggunakan pola yang mudah ditebak, seseorang bisa mencoba membuat QR sendiri tanpa harus melihat QR yang ditampilkan dosen di kelas. Jika sistem menerimanya, orang tersebut dapat melakukan presensi dari luar kelas. Asumsi: QR belum dibuat dengan nilai acak yang kuat dan sulit ditebak.",
                  "mitigation": "Token acak kriptografis (minimal 128 bit) atau ditandatangani (HMAC) dan terikat sesi; kedaluwarsa sesuai masa sesi; tidak memuat informasi yang dapat ditebak.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 10,
                  "score": "4"
                },
                {
                  "id": "ee065dbd-4241-46a2-ab40-7779c7775a92",
                  "title": "T11 - Sistem kewalahan karena terlalu banyak permintaan presensi",
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of Service",
                  "description": "Saat sesi dibuka, banyak mahasiswa mungkin memindai QR hampir bersamaan. Jika ada terlalu banyak permintaan, baik dari mahasiswa maupun bot, sistem bisa menjadi lambat atau tidak dapat digunakan sebelum sesi berakhir. Akibatnya, mahasiswa yang benar-benar hadir justru gagal melakukan presensi. Asumsi: kapasitas layanan terbatas dan belum ada pembatasan jumlah permintaan.",
                  "mitigation": "Rate limiting per akun dan per IP; antrean atau skala otomatis; cache validasi status sesi; timeout dan kuota koneksi; monitoring dan alert; dosen dapat memperpanjang sesi atau menandai hadir manual.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 11,
                  "score": "6"
                },
                {
                  "id": "365f85f0-cd1f-48f3-9dd2-479948b134c0",
                  "title": "T13 - Mahasiswa dapat menggunakan fitur khusus dosen",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of Privilege",
                  "description": "Mahasiswa mungkin dapat mencoba membuka atau menutup sesi presensi maupun melihat daftar hadir dengan mengakses fungsi yang seharusnya hanya tersedia untuk dosen. Jika sistem hanya menyembunyikan tombol tanpa memeriksa hak akses di sisi server, tindakan tersebut masih mungkin dilakukan. Asumsi: pembatasan fitur belum diterapkan secara konsisten pada setiap fungsi.",
                  "mitigation": "RBAC di server pada setiap endpoint; peran diambil dari sumber tepercaya (token terverifikasi dan Database Akademik); jangan percaya klaim peran dari klien; uji otorisasi vertikal.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 13,
                  "score": "6"
                },
                {
                  "id": "a395522b-3da0-4a86-a286-46f7b0e1e500",
                  "title": "T14 - Dosen membuka sesi untuk kelas yang bukan tanggung jawabnya",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of Privilege",
                  "description": "Dosen yang bukan pengampu suatu kelas mungkin dapat membuka atau menutup sesi presensi kelas tersebut jika sistem tidak memeriksa hubungan antara dosen dan kelas yang dipilih. Akibatnya, kegiatan presensi kelas lain dapat terganggu. Asumsi: sistem hanya memeriksa bahwa pengguna adalah dosen, belum memastikan bahwa dosen tersebut mengampu kelas terkait.",
                  "mitigation": "Validasi relasi dosen-kelas-jadwal dari Database Akademik pada setiap perintah sesi; audit log aksi sesi; batasi sesi sesuai jadwal kelas.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 14,
                  "score": "4"
                },
                {
                  "id": "dc7e49cf-e617-4080-8f76-fcd146bf8ad9",
                  "title": "T17 - Presensi masih bisa dilakukan setelah sesi berakhir",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Tampering",
                  "description": "Jika waktu penutupan sesi tidak diperiksa dengan benar, mahasiswa mungkin masih dapat mengirim presensi setelah batas waktu berakhir. Perubahan waktu pada perangkat juga bisa dimanfaatkan jika sistem mengikuti waktu dari perangkat, bukan waktu server. Akibatnya, catatan kehadiran tidak sesuai dengan waktu presensi yang ditetapkan. Asumsi: pemeriksaan waktu dan status sesi belum sepenuhnya mengandalkan server.",
                  "mitigation": "Cek status dan expires_at di server pada setiap permintaan; gunakan waktu server dengan sinkronisasi NTP; penutupan sesi atomik; tolak presensi untuk sesi tertutup.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 17,
                  "score": "4"
                }
              ],
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
              "privilegeLevel": ""
            }
          },
